# Where contact form inquiries are delivered
CONTACT_TO_EMAIL=edokasomtochukwu@gmail.com

# Sender address. Must be on a domain verified in Resend.
# Before verifying your own domain, use: SomtoScript <onboarding@resend.dev>
CONTACT_FROM_EMAIL=SomtoScript <onboarding@resend.dev>
